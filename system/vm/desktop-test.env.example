# Copy this file to desktop-test.local.env and edit it for your machine.
# This file is tuned for a zero-click Ubuntu Server autoinstall that adds a KDE session.

LIBVIRT_URI="qemu:///system"
VM_NAME="config-desktop-test"
VM_PRESET="ubuntu-24.04-server-kde"
VCPUS="3"
RAM_MB="8192"
DISK_SIZE_GB="64"
NETWORK_NAME="default"
BOOT_FIRMWARE="uefi"
GRAPHICS="spice"
VIDEO_MODEL="virtio"
SNAPSHOT_NAME="fresh-install"
VM_ACCEL="kvm"

AUTOINSTALL_HOSTNAME="config-desktop-test"
AUTOINSTALL_USERNAME="ubuntu"
AUTOINSTALL_REALNAME="Desktop Test"
AUTOINSTALL_PASSWORD="ubuntu"
AUTOINSTALL_LOCALE="en_US.UTF-8"
AUTOINSTALL_KEYBOARD_LAYOUT="us"
AUTOINSTALL_TIMEZONE="UTC"
AUTOINSTALL_INSTALL_OPENSSH="1"
AUTOINSTALL_ALLOW_PW="1"
AUTOINSTALL_AUTO_APPLY_CONFIG="1"

# Optional overrides:
# Available presets:
#   ubuntu-24.04-server-kde
#   ubuntu-24.04-server-smoke
#   ubuntu-24.04-desktop
#   kubuntu-24.04-desktop
# VM_PRESET="ubuntu-24.04-server-smoke"
# VM_PRESET="ubuntu-24.04-desktop"
# VM_PRESET="kubuntu-24.04-desktop"
# ISO_PATH="/path/to/already-downloaded.iso"
# ISO_URL="https://example.com/custom.iso"
# ISO_FILENAME="custom.iso"
# ISO_SHA256="..."
# OSINFO_NAME="ubuntu24.04"
# DISK_PATH="/var/lib/libvirt/images/config-desktop-test.qcow2"
# ISO_CACHE_DIR="/var/tmp/config-vm/isos"
# AUTOINSTALL_OUTPUT_DIR="/var/tmp/config-vm/config-desktop-test/autoinstall"
# AUTOINSTALL_AUTO_APPLY_CONFIG="0"
# AUTOINSTALL_INCLUDE_BOOTSTRAP_PACKAGES="0"
# AUTOINSTALL_SOURCE_ID="ubuntu-server-minimal"
# AUTOINSTALL_CONFIG_REPO_MODE="remote-clone"
# AUTOINSTALL_CONFIG_REPO_URL defaults to the current git remote converted to HTTPS
# AUTOINSTALL_CONFIG_REPO_REF defaults to the current git branch
# AUTOINSTALL_CONFIG_REPO_URL="https://github.com/Aureatus/config.git"
# AUTOINSTALL_CONFIG_REPO_REF="main"
# AUTOINSTALL_CONFIG_PLAYBOOK="ansible/playbooks/desktop.yml"
# FORCE_ISO_REFRESH="1"
# VM_AUTOSTART="1"
# VM_ACCEL="tcg"
# AUTOINSTALL_PASSWORD_HASH="$6$..."
# AUTOINSTALL_SSH_KEY_FILE="$HOME/.ssh/id_ed25519.pub"
# AUTOINSTALL_ENABLE_AUTOLOGIN="0"
